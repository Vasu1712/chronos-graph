# secrets
.env

# raw datasets (checksums are tracked)
data/raw/*
!data/raw/CHECKSUMS
!data/raw/.gitkeep

# databases and the LLM response cache (too large for git); raw outputs and summaries are committed
*.sqlite
*.sqlite-wal
*.sqlite-shm

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# os / editors
.DS_Store
.vscode/
.idea/
