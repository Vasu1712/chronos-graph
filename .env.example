# --- Judge providers (evaluation only) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Optional overrides for judge rate limits (defaults shown)
GROQ_RPM=30
GROQ_TPM=8000
GROQ_TPD=200000
CEREBRAS_RPM=5
CEREBRAS_TPM=90000
CEREBRAS_TPD=1000000

# --- Local system LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# --- Paths ---
CHRONOS_DB_PATH=artifacts/chronos.sqlite
CHRONOS_LLM_CACHE_PATH=artifacts/llm_cache.sqlite

# --- Devices (mps | cpu) ---
CHRONOS_DEVICE=mps
